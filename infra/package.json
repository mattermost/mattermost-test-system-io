{
  "name": "mattermost-test-system-io-infra",
  "private": true,
  "scripts": {
    "lint": "oxlint ./lib ./bin ./test",
    "format": "oxfmt ./lib ./bin ./test --write",
    "format:check": "oxfmt ./lib ./bin ./test --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "outdated": "npm outdated",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff",
    "cdk:deploy": "cdk deploy"
  },
  "dependencies": {
    "aws-cdk-lib": "2.257.0",
    "constructs": "10.6.0",
    "dotenv": "17.4.2",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "aws-cdk": "2.1125.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
