# ==============================================================================
# Test System IO Server - Environment Configuration
# ==============================================================================
#
# DEVELOPMENT: Only RUST_ENV is required. All other values use sensible defaults.
# PRODUCTION:  RUST_ENV, TSIO_DB_URL, and TSIO_AUTH_ADMIN_KEY are required.
#              Server will NOT start if production values match development defaults.
#
# ==============================================================================

# Environment (REQUIRED)
# Options: development, production (or dev, prod)
RUST_ENV=development

# Logging level (standard RUST_LOG env var)
RUST_LOG=info,actix_web=info,tsio=debug

# ==============================================================================
# SERVER
# ==============================================================================

# TSIO_SERVER_HOST=127.0.0.1
# TSIO_SERVER_PORT=8080
# TSIO_SERVER_STATIC_DIR=/app/static
# TSIO_SERVER_ALLOWED_ORIGINS=https://tsio.example.com
# TSIO_SERVER_WORKERS=4
# TSIO_SERVER_BACKLOG=1024
# TSIO_SERVER_MAX_CONNECTIONS=25000
# TSIO_SERVER_MAX_CONNECTION_RATE=256

# ==============================================================================
# DATABASE
# ==============================================================================

# Option 1: Full connection string
# TSIO_DB_URL=postgres://user:password@localhost:5432/tsio

# Option 2: Individual components (requires TSIO_DB_PASSWORD)
# TSIO_DB_HOST=localhost
# TSIO_DB_PORT=5432
# TSIO_DB_USER=tsio
# TSIO_DB_PASSWORD=tsio
# TSIO_DB_NAME=tsio

# Connection pool settings
# TSIO_DB_MAX_CONNECTIONS=20
# TSIO_DB_MIN_CONNECTIONS=2
# TSIO_DB_CONNECT_TIMEOUT_SECS=10
# TSIO_DB_ACQUIRE_TIMEOUT_SECS=10
# TSIO_DB_IDLE_TIMEOUT_SECS=600
# TSIO_DB_MAX_LIFETIME_SECS=1800

# ==============================================================================
# S3 / MINIO STORAGE
# ==============================================================================

# TSIO_S3_ENDPOINT=http://localhost:9000
# TSIO_S3_BUCKET=tsio
# TSIO_S3_REGION=us-east-1
# TSIO_S3_ACCESS_KEY=minioadmin
# TSIO_S3_SECRET_KEY=minioadmin

# ==============================================================================
# AUTHENTICATION
# ==============================================================================

# Admin key (REQUIRED in production - must be at least 32 characters)
# TSIO_AUTH_ADMIN_KEY=your-secure-admin-key-at-least-32-characters

# ==============================================================================
# GITHUB OIDC
# ==============================================================================

# Enable OIDC authentication (required for `make seed` and OIDC-based uploads)
TSIO_GITHUB_OIDC_ENABLED=true

# OIDC issuer URL
# Development: points to mock JWKS server started by upload-seed.js
# Production: https://token.actions.githubusercontent.com
TSIO_GITHUB_OIDC_ISSUER=http://localhost:9090

# Audience validation (recommended for production)
# TSIO_GITHUB_OIDC_AUDIENCE=https://your-tsio-instance.example.com

# Restrict to specific repos (comma-separated, empty = use OIDC policies)
# TSIO_GITHUB_OIDC_ALLOWED_REPOS=org/repo1,org/repo2

# ==============================================================================
# GITHUB OAUTH (optional - for web UI login)
# ==============================================================================

# TSIO_GITHUB_OAUTH_ENABLED=false
# TSIO_GITHUB_OAUTH_CLIENT_ID=
# TSIO_GITHUB_OAUTH_CLIENT_SECRET=
# TSIO_GITHUB_OAUTH_ALLOWED_ORGS=
# TSIO_GITHUB_OAUTH_SESSION_SECRET=
# TSIO_GITHUB_OAUTH_ACCESS_TOKEN_TTL_SECS=3600
# TSIO_GITHUB_OAUTH_REFRESH_TOKEN_TTL_SECS=604800
# TSIO_GITHUB_OAUTH_REDIRECT_URL=

# ==============================================================================
# WEB CLIENT (Vite)
# ==============================================================================

# WebSocket URL override (optional — auto-derived from page host in both dev and production)
# Only needed for unusual setups, e.g. connecting to a remote backend
# VITE_WS_URL=ws://localhost:8080/api/v1/ws

# ==============================================================================
# FEATURES
# ==============================================================================

# TSIO_FEATURE_HTML_VIEW_ENABLED=true
# TSIO_FEATURE_SEARCH_MIN_LENGTH=3
# TSIO_FEATURE_UPLOAD_MAX_SIZE=52428800
# TSIO_FEATURE_UPLOAD_TIMEOUT_MS=3600000
