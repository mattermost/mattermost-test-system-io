new file mode 100644
index 0000000000..98d40611b0
--- /dev/null
+++ b/.github/scripts/tsio-assert-results.test.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -euo pipefail
+# Exercise the exact workflow assertion extracted by the patch verification job.
+assert_result() {
+  if [ "$1" = true ]; then return 0
+  elif [ "$2" = enforce ]; then
+    [ "$5" = success ] && { [ "$3" = SUCCESS ] || [ "$3" = NEUTRAL ]; }
+  elif [ "$2" = shadow ] || [ "$2" = off ]; then
+    [ "$4" = success ] && [ "$6" = success ]
+  else return 1; fi
+}
+assert_result true enforce REGRESSION failure failure success
+assert_result false enforce SUCCESS failure success success
+assert_result false enforce NEUTRAL failure success success
+! assert_result false enforce REGRESSION success success success
+! assert_result false enforce INCOMPLETE success success success
+! assert_result false enforce SUCCESS success failure success
+assert_result false shadow REGRESSION success success success
+! assert_result false shadow SUCCESS failure success success
+! assert_result false unavailable SUCCESS success success success
+printf 'triage final assertion: 9 cases passed\n'
diff --git a/.github/scripts/tsio-finalize-status.mjs b/.github/scripts/tsio-finalize-status.mjs
new file mode 100644
index 0000000000..8a2ab7af68
--- /dev/null
+++ b/.github/scripts/tsio-finalize-status.mjs
@@ -0,0 +1,47 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+import {appendFileSync} from 'node:fs';
+
+// The raw summary no longer writes statuses: this guarded finalizer preserves
+// shadow/off behavior without overwriting human verification or a newer attempt.
+const identity = JSON.parse(process.env.TSIO_IDENTITY);
+const repository = identity.repository;
+const context = process.env.TSIO_CONTEXT;
+async function api(path, body) {
+    const response = await fetch(`https://api.github.com/repos/${path}`, {
+        method: body ? 'POST' : 'GET',
+        signal: AbortSignal.timeout(30000),
+        headers: {Authorization: `Bearer ${process.env.GITHUB_TOKEN}`, Accept: 'application/vnd.github+json', 'Content-Type': 'application/json'},
+        ...(body ? {body: JSON.stringify(body)} : {}),
+    });
+    if (!response.ok) throw new Error(`GitHub API failed: ${response.status}`);
+    return response.json();
+}
+async function currentAttempt() {
+    const run = await api(`${process.env.GITHUB_REPOSITORY}/actions/runs/${identity.gh_run_id}`);
+    return (run.run_attempt || 1) <= Number(identity.gh_run_attempt);
+}
+if (!await currentAttempt()) process.exit(0);
+// Human verification is per head SHA: the "E2E Tests/verified" label persists on
+// the PR after later pushes, so it is never read live. Only the (verified) status
+// marker on this SHA (written by e2e-tests-verified-label.yml / override-status)
+// counts, until an explicit pending reset.
+let overridden = false;
+for (let page = 1; !overridden; page++) {
+    const statuses = await api(`${repository}/commits/${identity.commit_sha}/statuses?per_page=100&page=${page}`);
+    const history = statuses.filter((status) => status.context === context);
+    const reset = history.findIndex((status) => status.state === 'pending' && /removed|reset|revoked/i.test(status.description || ''));
+    overridden = (reset < 0 ? history : history.slice(0, reset)).some((status) => status.state === 'success' && /\(verified\)/i.test(status.description || ''));
+    if (reset >= 0 || statuses.length < 100) break;
+}
+if (overridden && process.env.GITHUB_OUTPUT) appendFileSync(process.env.GITHUB_OUTPUT, 'human-override=true\n');
+// Enforce status is owned by the triage action. Human overrides still win if
+// applied during the gap between that action and this finalizer.
+if (!overridden && process.env.TRIAGE_MODE === 'enforce') process.exit(0);
+const modeKnown = ['off', 'shadow'].includes(process.env.TRIAGE_MODE);
+if (await currentAttempt()) await api(`${repository}/statuses/${identity.commit_sha}`, {
+    context,
+    state: overridden || (modeKnown && process.env.SUMMARY_OUTCOME === 'success') ? 'success' : 'failure',
+    description: (overridden ? 'TSIO triage (verified)' : modeKnown ? process.env.STATUS_DESCRIPTION || 'E2E summary failed' : 'Triage unavailable; refusing raw-result fallback').slice(0, 140),
+    ...(process.env.REPORT_URL ? {target_url: process.env.REPORT_URL} : {}),
+});
