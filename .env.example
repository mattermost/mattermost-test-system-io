# ==============================================================================
# Test System IO Server (Go) - Environment Configuration
# ==============================================================================
#
# Defaults below are tuned for the local `docker compose -f docker/docker-compose.dev.yml`
# stack: Postgres 18.3 on host port 6432 and MinIO on host port 9100.
#
# Required for the server to start:
#   TSIO_DATABASE_URL
#   TSIO_S3_BUCKET
#   TSIO_S3_ACCESS_KEY
#   TSIO_S3_SECRET_KEY
#   TSIO_SESSION_SECRET
#
# Copy this file to `.env` (gitignored) and adjust for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# HTTPS server
# ------------------------------------------------------------------------------
# Requests that do not arrive over HTTPS (either r.TLS != nil or
# X-Forwarded-Proto=https) are rejected with 426 Upgrade Required, except for
# /health, /healthz, /ready.
#
# Local dev: generate a locally-trusted cert with mkcert
# (https://github.com/FiloSottile/mkcert):
#   brew install mkcert nss && mkcert -install
#   mkdir -p certs
#   mkcert -cert-file certs/localhost.pem -key-file certs/localhost-key.pem localhost 127.0.0.1 ::1
# Then point TSIO_TLS_CERT_FILE / TSIO_TLS_KEY_FILE at the generated files and
# tsio listens with ListenAndServeTLS on TSIO_HTTP_LISTEN_ADDR.
#
# Staging/prod: leave the cert vars empty. The ALB terminates TLS and forwards
# plain HTTP on the private network; the RequireHTTPS middleware verifies
# X-Forwarded-Proto on every request.
TSIO_HTTP_LISTEN_ADDR=:8443
TSIO_TLS_CERT_FILE=certs/localhost.pem
TSIO_TLS_KEY_FILE=certs/localhost-key.pem

# Comma-separated CORS origins. Leave empty to disable CORS middleware.
TSIO_CORS_ALLOWED_ORIGINS=https://localhost:3000

# ------------------------------------------------------------------------------
# Database (PostgreSQL 18.3)
# ------------------------------------------------------------------------------
# Docker-compose maps Postgres to host port 6432.
TSIO_DATABASE_URL=postgres://tsio:tsio@localhost:6432/tsio?sslmode=disable

# Auto-apply migrations on server start (forward-only, idempotent).
# Migrations are embedded into the binary at build time; disable if you prefer
# to run `tsioctl db migrate` out-of-band before the app starts.
TSIO_DB_AUTO_MIGRATE=true

# ------------------------------------------------------------------------------
# Object storage (S3 / MinIO)
# ------------------------------------------------------------------------------
# Docker-compose maps MinIO to host port 9100.
TSIO_S3_ENDPOINT=http://localhost:9100
TSIO_S3_REGION=us-east-1
TSIO_S3_BUCKET=reports
TSIO_S3_ACCESS_KEY=minioadmin
TSIO_S3_SECRET_KEY=minioadmin
TSIO_S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# GitHub OAuth (human sign-in)
# ------------------------------------------------------------------------------
# Leave unset to disable the sign-in endpoints; API-key auth still works.
# TSIO_GITHUB_OAUTH_CLIENT_ID=
# TSIO_GITHUB_OAUTH_CLIENT_SECRET=
# TSIO_GITHUB_OAUTH_REDIRECT_URL=https://localhost:8443/api/v1/auth/github/callback

# ------------------------------------------------------------------------------
# GitHub Actions OIDC (CI workload auth)
# ------------------------------------------------------------------------------
# Dev defaults: the local mock provider issues tokens with aud=tsio. Set the
# audience (instead of leaving it empty) so dev exercises the same aud check
# production does. An empty issuer disables OIDC entirely.
#
# In production set:
#   TSIO_GITHUB_ACTIONS_OIDC_ISSUER=https://token.actions.githubusercontent.com
#   TSIO_GITHUB_ACTIONS_OIDC_AUDIENCE=<your audience claim>
TSIO_GITHUB_ACTIONS_OIDC_ISSUER=http://localhost:9090
TSIO_GITHUB_ACTIONS_OIDC_AUDIENCE=tsio

# ------------------------------------------------------------------------------
# Sessions & credentials
# ------------------------------------------------------------------------------
# MUST be replaced in production. Any non-empty value works for local dev.
TSIO_SESSION_SECRET=dev-session-secret-change-me
TSIO_SESSION_TTL=720h
TSIO_REFRESH_TOKEN_TTL=720h
TSIO_APIKEY_ROTATION_GRACE=24h

# ------------------------------------------------------------------------------
# Upload limits
# ------------------------------------------------------------------------------
TSIO_MAX_UPLOAD_BYTES=1073741824        # 1 GiB
TSIO_MAX_ARTIFACT_BYTES=104857600       # 100 MiB

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
TSIO_LOG_LEVEL=info          # debug | info | warn | error
TSIO_LOG_FORMAT=text         # json in prod, text in dev
