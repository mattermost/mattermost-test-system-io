diff --git a/detox/utils/tsio-triage-status.test.js b/detox/utils/tsio-triage-status.test.js
new file mode 100644
index 0000000000..5d865e32f6
--- /dev/null
+++ b/detox/utils/tsio-triage-status.test.js
@@ -0,0 +1,65 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const {reportTsioStatus} = require('./tsio-report-status');
+const {buildTsioJobConfig} = require('./build-tsio-job-config');
+const identity = {repository: 'mattermost/mattermost-mobile', commit_sha: 'abc', gh_run_id: '1', gh_run_attempt: '1', gh_pr_number: 3, name: 'mobile-pr-detox-ios'};
+
+for (const [name, options, expected, fails] of [
+    ['enforce blocks', {triageMode: 'enforce', triageState: 'failure'}, 'failure', true],
+    ['enforce exonerates', {triageMode: 'enforce', triageState: 'success'}, 'success', false],
+    ['override precedes enforce', {e2eOverride: true, triageMode: 'enforce', triageState: 'failure'}, 'success', false],
+    ['unknown policy blocks raw fallback', {triageMode: 'unavailable'}, 'failure', true],
+    ['verified label from an earlier commit does not waive', {triageMode: 'enforce', triageState: 'failure', verified: true}, 'failure', true],
+    ['shadow keeps the raw path with override conversion', {triageMode: 'shadow', e2eOverride: true, raw: true}, 'success', false],
+    ['removed override revokes earlier action output', {e2eOverride: true, removed: true, triageMode: 'enforce', triageState: 'failure'}, 'failure', true],
+    ['old attempt never posts', {triageMode: 'enforce', triageState: 'failure', stale: true}, undefined, false],
+]) {
+    test(name, async () => {
+        const original = global.fetch;
+        const statuses = [];
+        global.fetch = async (url, init) => {
+            if (options.raw) {
+                // Shadow must not touch GitHub before the write; only the status POST is allowed.
+                if (url.includes('/statuses/')) {statuses.push(JSON.parse(init.body)); return Response.json({});}
+                throw new Error(`Shadow made an unexpected GitHub read: ${url}`);
+            }
+            if (url.includes('/actions/runs/')) return Response.json({run_attempt: options.stale ? 2 : 1});
+            if (url.includes('/pulls/')) return Response.json({labels: options.verified ? [{name: 'E2E/Verified'}] : options.e2eOverride && !options.removed ? [{name: 'E2E/Override'}] : []});
+            if (url.includes('/statuses/')) {statuses.push(JSON.parse(init.body)); return Response.json({});}
+            throw new Error(`Unexpected API request: ${url}`);
+        };
+        try {
+            const {verified, raw, removed, stale, ...passthrough} = options;
+            const promise = reportTsioStatus({compositeIdentity: identity, githubToken: 'test-only', commitStatusContext: 'e2e-test/detox-ios', pollAttempts: 1, ...passthrough});
+            if (fails) await assert.rejects(promise, /triage blocked|TSIO/);
+            else await promise;
+            assert.equal(statuses[0]?.state, expected);
+            if (verified) assert.doesNotMatch(statuses[0].description, /verified/);
+            if (options.e2eOverride && !removed) assert.match(statuses[0].description, /^E2E\/Override — /);
+            void stale;
+        } finally {global.fetch = original;}
+    });
+}
+test('metadata keeps one report and platform lanes', () => {
+    for (const [job, lane] of [['detox-ios', 'ios'], ['detox-ipad', 'ipad'], ['detox-android', 'android']]) {
+        const config = buildTsioJobConfig({...identity, name: 'mobile-pr', base_ref: 'main', base_sha: 'def'}, job);
+        assert.equal(config.total_reports_expected, 1);
+        assert.equal(config.composite_identity.environment_metadata.lane, lane);
+        assert.equal(config.composite_identity.branch_kind, 'pr');
+        assert.equal(config.composite_identity.base_sha, 'def');
+    }
+});
+
+test('resolver enriches pre-expanded platform identity with fresh merge base', () => {
+    const {execFileSync} = require('node:child_process');
+    const config = {status_context: 'e2e-test/detox-ios', composite_identity: {...identity, base_sha: ''}};
+    const output = execFileSync('bash', [require('node:path').join(__dirname, 'resolve-tsio-job-config.sh')], {
+        env: {...process.env, TSIO_CONFIG: JSON.stringify(config), TSIO_BASE_REF: 'main', TSIO_BASE_SHA: 'resolved-base'}, encoding: 'utf8',
+    });
+    const resolved = JSON.parse(output);
+    assert.equal(resolved.composite_identity.base_sha, 'resolved-base');
+    assert.equal(resolved.composite_identity.environment_metadata.lane, 'ios');
+    assert.equal(resolved.status_context, config.status_context);
+});
