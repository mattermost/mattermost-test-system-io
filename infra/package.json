{
  "name": "mattermost-test-system-io-infra",
  "private": true,
  "scripts": {
    "lint": "oxlint ./lib ./bin ./test",
    "format": "oxfmt ./lib ./bin ./test --write",
    "format:check": "oxfmt ./lib ./bin ./test --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "outdated": "npm outdated",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff",
    "cdk:deploy": "cdk deploy"
  },
  "dependencies": {
    "aws-cdk-lib": "2.271.0",
    "constructs": "10.8.1",
    "dotenv": "18.0.4",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "aws-cdk": "2.1143.0",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
