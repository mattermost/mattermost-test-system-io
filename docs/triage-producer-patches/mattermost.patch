diff --git a/e2e-tests/playwright/lib/quarantine.ts b/e2e-tests/playwright/lib/quarantine.ts
new file mode 100644
index 0000000000..bb65843f2c
--- /dev/null
+++ b/e2e-tests/playwright/lib/quarantine.ts
@@ -0,0 +1,11 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+/** Opt-in only: download the lane's TSIO playwright-grep-invert response first. */
+export function quarantineGrepInvert(env: NodeJS.ProcessEnv = process.env): RegExp | undefined {
+    if (env.E2E_TRIAGE_SKIP_QUARANTINED !== 'true' || !env.QUARANTINE_REGEX?.trim()) {
+        return undefined;
+    }
+    // Invalid expressions fail configuration instead of silently skipping the suite.
+    return new RegExp(env.QUARANTINE_REGEX);
+}
